@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# glyph is a static library, so texere is in its link interface whenever
# GLYPH_USE_TEXERE was on for the build that produced this package, and it has
# to be findable before glyphTargets.cmake is included.
if(@GLYPH_USE_TEXERE@)
  find_dependency(texere CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/glyphTargets.cmake")
